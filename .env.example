# --------------------------------------------------------------------------------
# NetBox Deployment Environment Variables Template
# --------------------------------------------------------------------------------

# --- NetBox Core Configuration ---
# MUST CHANGE: Generate a secret key (e.g., using python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=replace-me-with-a-secure-secret-key

# Hostnames allowed to connect (e.g., netbox.example.com, localhost)
ALLOWED_HOSTS=*

# --- Database Configuration ---
POSTGRES_DB=netbox
POSTGRES_USER=netbox
POSTGRES_PASSWORD=netbox_db_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis Configuration ---
REDIS_PASSWORD=redis_secure_password
REDIS_HOST=redis
REDIS_PORT=6379

REDIS_CACHE_PASSWORD=redis_cache_secure_password
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PORT=6379

# --- Automation / API Settings ---
# Used by the automation container to interact with NetBox
SUPERUSER_NAME=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=admin
SUPERUSER_API_TOKEN=0123456789abcdef0123456789abcdef01234567

NETBOX_URL=http://netbox:8080
NETBOX_TOKEN=${SUPERUSER_API_TOKEN}
